{
  "name": "graficos-de-investigacao",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Editor manual de gráficos de investigação química com funcionamento offline.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && npm run test && vite build",
    "build:only": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "pwa:assets": "pwa-assets-generator"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vite-pwa/assets-generator": "^2.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
